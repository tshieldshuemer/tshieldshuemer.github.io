---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);
const postsWithImages = sortedPosts.filter(
  (p): p is typeof p & { data: { heroImage: NonNullable<typeof p.data.heroImage> } } =>
    p.data.heroImage !== undefined
);
---

<Layout title={`Collage | ${SITE.title}`}>
  <Header />
  <main id="main-content" class="mx-auto w-full max-w-app px-4 py-8">
    <section class="collage-grid">
      {postsWithImages.map(p => (
        <a href={`/posts/${p.id}`} class="collage-item" aria-label={p.data.title}>
          {typeof p.data.heroImage === "string" ? (
            <img
              src={p.data.heroImage}
              alt=""
              loading="lazy"
              decoding="async"
              class="collage-img"
            />
          ) : (
            <Image
              src={p.data.heroImage!}
              alt=""
              loading="lazy"
              decoding="async"
              widths={[300, 500, 800]}
              sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 25vw"
              class="collage-img"
            />
          )}
        </a>
      ))}
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .collage-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
  }
  @media (min-width: 640px) {
    .collage-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (min-width: 1024px) {
    .collage-grid { grid-template-columns: repeat(4, 1fr); gap: 0.75rem; }
  }

  /* Brickwork offset (subtle, no clipping) */

  /* 2-column layout: offset rows shift right by a quarter column */
  .collage-item:nth-child(4n+3),
  .collage-item:nth-child(4n+4) {
    transform: translateX(25%);
  }

  /* 3-column layout */
  @media (min-width: 640px) {
    .collage-item:nth-child(4n+3),
    .collage-item:nth-child(4n+4) {
      transform: none;
    }
    .collage-item:nth-child(6n+4),
    .collage-item:nth-child(6n+5),
    .collage-item:nth-child(6n+6) {
      transform: translateX(16.66%);
    }
  }

  /* 4-column layout */
  @media (min-width: 1024px) {
    .collage-item:nth-child(6n+4),
    .collage-item:nth-child(6n+5),
    .collage-item:nth-child(6n+6) {
      transform: none;
    }
    .collage-item:nth-child(8n+5),
    .collage-item:nth-child(8n+6),
    .collage-item:nth-child(8n+7),
    .collage-item:nth-child(8n+8) {
      transform: translateX(12.5%);
    }
  }

  .collage-item {
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 6px;
    background: #eee;
  }

  .collage-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 200ms ease, filter 200ms ease;
  }

  .collage-item:hover .collage-img,
  .collage-item:focus-visible .collage-img {
    transform: scale(1.04);
    filter: brightness(1.05);
  }
</style>
