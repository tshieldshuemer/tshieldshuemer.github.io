---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);
const postsWithImages = sortedPosts.filter(
  (p): p is typeof p & { data: { ogImage: NonNullable<typeof p.data.ogImage> } } =>
    p.data.ogImage !== undefined
);
---

<Layout title={`Collage | ${SITE.title}`}>
  <Header />
  <main id="main-content" class="mx-auto w-full max-w-app px-4 pb-12">
    <section class="pt-8 pb-6">
      <h1 class="text-2xl font-semibold sm:text-3xl">Collage</h1>
      <p class="mt-2 text-sm opacity-80">Click any image to open the post.</p>
    </section>

    <section class="collage-grid">
      {postsWithImages.map(p => (
        <a href={`/posts/${p.id}`} class="collage-item" aria-label={p.data.title}>
          {typeof p.data.ogImage === "string" ? (
            <img
              src={p.data.ogImage}
              alt=""
              loading="lazy"
              decoding="async"
              class="collage-img"
            />
          ) : (
            <Image
              src={p.data.ogImage}
              alt=""
              loading="lazy"
              decoding="async"
              widths={[300, 500, 800]}
              sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 25vw"
              class="collage-img"
            />
          )}
        </a>
      ))}
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .collage-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
  }
  @media (min-width: 640px) {
    .collage-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (min-width: 1024px) {
    .collage-grid { grid-template-columns: repeat(4, 1fr); gap: 0.75rem; }
  }

  .collage-item {
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 6px;
    background: #eee;
  }

  .collage-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 200ms ease, filter 200ms ease;
  }

  .collage-item:hover .collage-img,
  .collage-item:focus-visible .collage-img {
    transform: scale(1.04);
    filter: brightness(1.05);
  }
</style>
